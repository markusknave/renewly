# Copy to .env and adjust. Never commit .env.

# --- Server ---
PORT=8787
RENEWLY_BASE_URL=http://localhost:8787
# Set true when served over HTTPS (recommended in production).
RENEWLY_SECURE_COOKIES=false
# Set to 1 when behind a reverse proxy (nginx, Caddy, Cloudflare Tunnel).
RENEWLY_TRUST_PROXY=0
NODE_ENV=development

# --- Storage ---
# Directory for the SQLite database and auto-generated secrets. Must be private.
RENEWLY_DATA_DIR=data

# --- Secrets (auto-generated under RENEWLY_DATA_DIR if omitted) ---
# 32 random bytes, base64. Generate: openssl rand -base64 32
# RENEWLY_MASTER_KEY=
# RENEWLY_EMAIL_WEBHOOK_SECRET=
# Optional extra signature check for transaction webhooks.
# RENEWLY_TXN_WEBHOOK_SECRET=

# --- Inbound email (receipt forwarding) ---
# Addresses look like renewly+<token>@<domain>. Point your provider's inbound
# route/webhook at POST /webhooks/email (or /webhooks/email/:token for testing).
RENEWLY_INGEST_DOMAIN=in.renewly.local

# --- Notifications (optional) ---
# Any URL that accepts a JSON POST (Slack/Discord/ntfy/your own service).
# RENEWLY_NOTIFY_WEBHOOK_URL=
# Resend (email delivery). Leave empty to disable email notifications.
# RESEND_API_KEY=
# RENEWLY_NOTIFY_FROM=Renewly <renewly@example.com>

# --- Plaid (optional bank aggregation) ---
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=
# PLAID_SECRET=
