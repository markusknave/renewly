{
  "name": "renewly",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Offline-first subscription tracker for Android and the web",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "serve": "node scripts/serve.mjs public",
    "plans:refresh": "node scripts/refresh-plans.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  },
  "dependencies": {
    "@capacitor/local-notifications": "8.3.1"
  }
}
