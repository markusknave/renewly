{
  "name": "renewly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted subscription renewal tracker with email/transaction ingestion",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "test": "node --test test/",
    "check": "node --check src/server.js",
    "icons": "node scripts/generate-icons.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  }
}
