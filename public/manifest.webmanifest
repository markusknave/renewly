{
  "id": "/",
  "name": "Renewly — Expenses & Subscriptions",
  "short_name": "Renewly",
  "description": "Track daily expenses, card balances, interest, goals, and subscriptions. Everything stays on this device.",
  "start_url": "./",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f5f6fb",
  "theme_color": "#4f46e5",
  "lang": "en",
  "dir": "ltr",
  "categories": ["finance", "productivity"],
  "icons": [
    {
      "src": "/icons/app-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/app-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Expense",
      "url": "./#/expenses",
      "icons": [{ "src": "./icons/app-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Transfer money",
      "short_name": "Transfer",
      "url": "./#/expenses?new=transfer",
      "icons": [{ "src": "./icons/app-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Import expenses",
      "short_name": "Import",
      "url": "./#/import",
      "icons": [{ "src": "./icons/app-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Goals",
      "short_name": "Goals",
      "url": "./#/goals",
      "icons": [{ "src": "./icons/app-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Subscriptions",
      "short_name": "Subscriptions",
      "url": "./#/subscriptions",
      "icons": [{ "src": "./icons/app-192.png", "sizes": "192x192" }]
    }
  ]
}
